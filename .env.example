# Copy to `.env` (at the repo root) and edit as needed.
# The backend loads this file automatically; Vite reads it via loadEnv;
# the podman container image consumes it via `--env-file .env`.

# Bind host for the backend. (The Vite dev server always binds 127.0.0.1
# locally — it's a developer tool, not a public listener.)
HOST=0.0.0.0

# FastAPI / MCP port. The podman image exposes only this port — the built
# frontend is served from the same process.
BACKEND_PORT=8000

# Vite dev-server port. Only used for local `npm run dev`; the container
# does not run Vite.
FRONTEND_PORT=5173

# Printer technology to simulate. Two values are recognized:
#   FDM   — Fused Deposition Modeling (default). The hot-end extrudes plastic
#           filament that builds up from the bed; the part visibly grows.
#   LPBF  — Laser Powder Bed Fusion. A laser fuses metal powder one layer at
#           a time; the build plate lowers and a recoater spreads fresh
#           powder before each layer. The part appears to "sink" as it's
#           printed and laser sparks fly at the active scan point.
# The slicer is shared between both modes for now — only the visualization
# changes. Case-insensitive; anything unrecognized falls back to FDM.
PRINTER_TYPE=FDM

# Default printer build volume in millimetres, as `x,y,z`. Applied to every
# new session at construction time; the UI's bed-size control still works at
# runtime. Falls back to the Prusa i3 MK3S+ volume (250,210,210) when unset
# or malformed.
# PRINTER_DIM="500,500,500"

# Atlas's public origin — used to resolve relative `/mcp/files/download/...`
# URLs that Atlas hands the `atlas_upload` MCP tool. When the simulator runs
# in a different container/host than Atlas this MUST be set, otherwise the
# tool tries to download from itself and 404s. With `--network=host` (see
# run.sh) the simulator shares the host's loopback, so plain `localhost` is
# fine for a local Atlas dev process.
# ATLAS_BASE_URL=http://localhost:8001

# Optional MCP tool allowlist. Comma-separated tool names — when set, only
# the listed tools are exposed to MCP clients; everything else stays hidden.
# Unset, empty, "*", or "all" exposes the full surface (default).
#
# Useful "drop file → watch it print" minimal surface:
#   MCP_ENABLED_TOOLS=open_viewer,atlas_upload_slice_simulate
# MCP_ENABLED_TOOLS=
