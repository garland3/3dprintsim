# Copy to `.env` (at the repo root) and edit as needed.
# Both the backend and the Vite dev server read from this file; the podman
# container image also accepts it via `--env-file .env`.

# Bind host for the backend (and the Vite dev server when running locally).
HOST=0.0.0.0

# FastAPI / MCP port. The podman image exposes only this port — the built
# frontend is served from the same process.
BACKEND_PORT=8000

# Vite dev-server port. Only used for local `npm run dev`; the container
# does not run Vite.
FRONTEND_PORT=5173
